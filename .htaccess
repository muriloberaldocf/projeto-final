# ==============================================================================
# HipoGabarito — Configurações de Segurança do Apache (.htaccess)
# ==============================================================================

# 1. Desativar listagem de diretórios
Options -Indexes

# 2. Bloquear acesso a arquivos sensíveis (.env, .git, .sql, .log, .md)
<FilesMatch "^\.|\.(env|sql|log|md|jsonl|ini|yml|yaml|pdf)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Cabeçalhos de Segurança HTTP
<IfModule mod_headers.c>
    # Evita que o navegador tente adivinhar o tipo MIME do arquivo (MIME sniffing)
    Header always set X-Content-Type-Options "nosniff"

    # Evita que o site seja incorporado em iframes externos (Clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Ativa proteção contra XSS em navegadores que suportam
    Header always set X-XSS-Protection "1; mode=block"

    # Política de Referrer para não vazar caminhos completos em links externos
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Proteger contra injeção de métodos HTTP inseguros (apenas GET, POST, HEAD, OPTIONS)
<LimitExcept GET POST HEAD OPTIONS>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</LimitExcept>
