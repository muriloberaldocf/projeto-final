# ============================================================
# EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE - HIPOGABARITO (.env.example)
# Copie este arquivo para .env no ambiente de produção/homologação.
# ============================================================

# Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vestilingo
DB_USER=root
DB_PASS=

# Configurações da Aplicação
APP_NAME=HipoGabarito
APP_ENV=development

# Inteligência Artificial — Corretor de Redações ENEM (Google Gemini)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
